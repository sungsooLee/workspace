{
  "name": "sb",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/sb/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project storybook --web",
