{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "esModuleInterop": true, // for json mock
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@learnway/config": ["../../libs/config/src/index.ts"],
      "@learnway/config/*": ["../../libs/config/src/lib/*"],
      "@learnway/hooks": ["../../libs/hooks/src/index.ts"],
      "@learnway/icons": ["../../libs/icons/src/index.ts"],
      "@learnway/shared": ["../../libs/shared/src/index.ts"],
      "@learnway/ui": ["../../libs/ui/src/index.ts"],
      "@learnway/ui/*": ["../../libs/ui/src/lib/*"],
      "@learnway/auth/*": ["../../libs/auth/src/lib/*"],
      "@learnway/styles/*": ["../../libs/styles/src/lib/*"],
      "@learnway/types": ["../../libs/types/src/index.ts"],
      "@app/*": ["src/app/*"],
      "@entities/*": ["src/entities/*"],
      "@features/*": ["src/features/*"],
      "@pages/*": ["src/pages/*"],
      "@shared/*": ["src/shared/*"],
      "@widgets/*": ["src/widgets/*"]
      // "@styles/*": ["../../libs/styles/src/lib/*"]
    }
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ],
  "extends": "../../tsconfig.base.json"
}
