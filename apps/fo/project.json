{
  "name": "fo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/fo/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "configurations": {
        "local": {
          "mode": "development",
          "envFile": ".env.local"
        },
        "dev": {
          "mode": "development",
          "envFile": ".env.dev"
        },
        "production": {
          "mode": "production",
          "envFile": ".env.prod"
        }
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/fo"
      },
      "configurations": {
        "local": {
          "mode": "development",
          "envFile": ".env.local"
        },
        "dev": {
          "mode": "development",
          "envFile": ".env.dev"
        },
        "production": {
          "mode": "production",
          "envFile": ".env.production"
        }
      }
    }
  }
}
