{
  "name": "pb-fo",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/pub/fo/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project pb-fo --web",
  "targets": {},
  "build": {
    "executor": "@nx/vite:build",
    "outputs": ["{options.outputPath}"],
    "options": {
      "outputPath": "dist/apps/pb-fo"
    },
    "configurations": {
      "local": {
        "mode": "development",
        "envFile": ".env.local"
      },
      "dev": {
        "mode": "development",
        "envFile": ".env.dev"
      },
      "production": {
        "mode": "production",
        "envFile": ".env.production"
      }
    }
  }
}
